{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Unoptimised, assertions live. The default for development.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CROSSBOOK_BUILD_TESTS": "ON",
        "CROSSBOOK_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimised. The only configuration whose numbers mean anything.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CROSSBOOK_BUILD_TESTS": "ON",
        "CROSSBOOK_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "bench",
      "inherits": "release",
      "displayName": "Release + benchmarks",
      "description": "Pulls Google Benchmark from GitHub on first configure, which is why it is not the release preset: the README's first build command should not reach the network, and on a locked-down desk it would fail there.",
      "cacheVariables": {
        "CROSSBOOK_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan",
      "description": "Memory errors and undefined behaviour. Not for timing.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CROSSBOOK_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "description": "Data races. Nothing in the library is threaded yet, so this earns its keep the day a feed thread lands, not before.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CROSSBOOK_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer",
      "description": "Coverage-guided fuzzing. Clang only.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CROSSBOOK_BUILD_TESTS": "OFF",
        "CROSSBOOK_BUILD_EXAMPLES": "OFF",
        "CROSSBOOK_BUILD_FUZZ": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
